# Postgres. Neon: copy the connection string from the Neon console (include ?sslmode=require).
# Local without Docker: run `npm run db:local` and use the line below.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres

# Password to open the app (single owner for now).
APP_PASSWORD=change-me

# Random secrets, 32+ characters each:  openssl rand -base64 32
AUTH_SECRET=
# Encrypts the WhatsApp session in the database. Changing it unlinks WhatsApp.
ENCRYPTION_KEY=

# Optional: email alerts for missed/failed wishes and WhatsApp disconnects (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Optional: Baileys log level (warn by default)
# BAILEYS_LOG_LEVEL=info
