{
  "name": "everywish",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "worker:console": "CHANNEL=console tsx --env-file-if-exists=.env.local worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neon/config": "^1.8.4",
    "@neon/env": "^1.5.1",
    "baileys": "^7.0.0-rc14",
    "drizzle-orm": "^0.45.3",
    "luxon": "^3.7.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
